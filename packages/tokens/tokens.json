{
  "$description": "Contrato de tokens semánticos común a Maquetario y Motiova (D5). Los nombres son compartidos; los valores son los de Maquetario. Cada clave hoja es el nombre CSS sin los guiones (--background, --material-sidebar…); los grupos de primer nivel sólo ordenan.",
  "color": {
    "$type": "color",
    "$description": "Nombres de shadcn/Motiova.",
    "background": {
      "$value": "#13242b",
      "$description": "Fondo de la ventana. Con Mica o vibrancy es transparente.",
      "$extensions": {
        "maquetario": {
          "var": "--surface-window"
        }
      }
    },
    "foreground": {
      "$value": "#f4f5ee",
      "$description": "Texto principal.",
      "$extensions": {
        "maquetario": {
          "var": "--text-primary"
        }
      }
    },
    "card": {
      "$value": "#17272d",
      "$description": "Superficie elevada: en Maquetario, las hojas y diálogos.",
      "$extensions": {
        "maquetario": {
          "var": "--material-sheet"
        }
      }
    },
    "card-foreground": {
      "$value": "#f4f5ee",
      "$extensions": {
        "maquetario": {
          "var": "--text-primary"
        }
      }
    },
    "popover": {
      "$value": "rgb(17 31 37)",
      "$description": "Menús, selectores y globos.",
      "$extensions": {
        "maquetario": {
          "var": "--material-popover"
        }
      }
    },
    "popover-foreground": {
      "$value": "#f4f5ee",
      "$extensions": {
        "maquetario": {
          "var": "--text-primary"
        }
      }
    },
    "primary": {
      "$value": "#36ceb9",
      "$description": "Acción principal (verde agua; en Maquetario, --action).",
      "$extensions": {
        "maquetario": {
          "var": "--action"
        }
      }
    },
    "primary-foreground": {
      "$value": "#0d2f2a",
      "$extensions": {
        "maquetario": {
          "var": "--text-on-accent"
        }
      }
    },
    "secondary": {
      "$value": "rgb(244 245 238 / 0.06)",
      "$description": "Relleno del botón secundario.",
      "$extensions": {
        "maquetario": {
          "var": "--surface-control"
        }
      }
    },
    "secondary-foreground": {
      "$value": "#f4f5ee",
      "$extensions": {
        "maquetario": {
          "var": "--text-primary"
        }
      }
    },
    "muted": {
      "$value": "rgb(11 23 28 / 0.62)",
      "$description": "Superficie apagada: en Maquetario, el fondo hundido de los campos.",
      "$extensions": {
        "maquetario": {
          "var": "--surface-field"
        }
      }
    },
    "muted-foreground": {
      "$value": "#b8c9c6",
      "$description": "Texto secundario.",
      "$extensions": {
        "maquetario": {
          "var": "--text-secondary"
        }
      }
    },
    "accent": {
      "$value": "rgb(244 245 238 / 0.11)",
      "$description": "Fondo sutil al pasar o resaltar (menús, filas), como en shadcn.",
      "$extensions": {
        "maquetario": {
          "var": "--surface-control-hover"
        }
      }
    },
    "accent-foreground": {
      "$value": "#f4f5ee",
      "$extensions": {
        "maquetario": {
          "var": "--text-primary"
        }
      }
    },
    "destructive": {
      "$value": "#e5806c",
      "$description": "Acciones que borran y errores.",
      "$extensions": {
        "maquetario": {
          "var": "--danger"
        }
      }
    },
    "border": {
      "$value": "rgb(214 240 234 / 0.14)",
      "$description": "Línea por defecto.",
      "$extensions": {
        "maquetario": {
          "var": "--line-default"
        }
      }
    },
    "input": {
      "$value": "rgb(214 240 234 / 0.14)",
      "$description": "Borde de los campos.",
      "$extensions": {
        "maquetario": {
          "var": "--line-default"
        }
      }
    },
    "ring": {
      "$value": "#e4b16c",
      "$description": "Anillo de foco (dorado en Maquetario).",
      "$extensions": {
        "maquetario": {
          "var": "--focus-ring"
        }
      }
    },
    "highlight": {
      "$value": "#e4b16c",
      "$description": "Marca escasa (Motiova: amarillo; Maquetario: dorado, sólo foco y \"estás acá\").",
      "$extensions": {
        "maquetario": {
          "var": "--text-mark"
        }
      }
    },
    "highlight-foreground": {
      "$value": "#0d2f2a",
      "$extensions": {
        "maquetario": {
          "var": "--text-on-accent"
        }
      }
    },
    "sidebar": {
      "$value": "rgb(19 36 43 / 0.94)",
      "$description": "Paneles laterales.",
      "$extensions": {
        "maquetario": {
          "var": "--material-sidebar"
        }
      }
    },
    "sidebar-foreground": {
      "$value": "#f4f5ee",
      "$extensions": {
        "maquetario": {
          "var": "--text-primary"
        }
      }
    },
    "sidebar-primary": {
      "$value": "#36ceb9",
      "$extensions": {
        "maquetario": {
          "var": "--action"
        }
      }
    },
    "sidebar-primary-foreground": {
      "$value": "#0d2f2a",
      "$extensions": {
        "maquetario": {
          "var": "--text-on-accent"
        }
      }
    },
    "sidebar-accent": {
      "$value": "rgb(54 206 185 / 0.16)",
      "$description": "Elemento elegido en un panel lateral.",
      "$extensions": {
        "maquetario": {
          "var": "--surface-selected"
        }
      }
    },
    "sidebar-accent-foreground": {
      "$value": "#f4f5ee",
      "$extensions": {
        "maquetario": {
          "var": "--text-primary"
        }
      }
    },
    "sidebar-border": {
      "$value": "rgb(214 240 234 / 0.08)",
      "$extensions": {
        "maquetario": {
          "var": "--line-subtle"
        }
      }
    },
    "sidebar-ring": {
      "$value": "#e4b16c",
      "$extensions": {
        "maquetario": {
          "var": "--focus-ring"
        }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "font-sans": {
      "$value": "'DM Sans', 'Segoe UI', system-ui, -apple-system, sans-serif",
      "$description": "Letra de la interfaz.",
      "$extensions": {
        "maquetario": {
          "var": "--font-ui",
          "scope": "body"
        }
      }
    },
    "font-heading": {
      "$value": "'DM Sans', 'Segoe UI', system-ui, -apple-system, sans-serif",
      "$description": "Letra de títulos (Motiova: Nunito; Maquetario: la misma de la interfaz).",
      "$extensions": {
        "maquetario": {
          "var": "--font-ui",
          "scope": "body"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "radius": {
      "$value": "8px",
      "$description": "Radio base: paneles y diálogos. Motiova deriva los demás de este con calc(); Maquetario los fija.",
      "$extensions": {
        "maquetario": {
          "var": "--radius-lg"
        }
      }
    },
    "radius-sm": {
      "$value": "4px",
      "$description": "Controles chicos.",
      "$extensions": {
        "maquetario": {
          "var": "--radius-sm"
        }
      }
    },
    "radius-md": {
      "$value": "6px",
      "$description": "Controles.",
      "$extensions": {
        "maquetario": {
          "var": "--radius-md"
        }
      }
    },
    "radius-lg": {
      "$value": "8px",
      "$description": "Paneles y diálogos.",
      "$extensions": {
        "maquetario": {
          "var": "--radius-lg"
        }
      }
    }
  },
  "material": {
    "$description": "Superficies con función (vidrio). Propios de Maquetario.",
    "material-sidebar": {
      "$type": "color",
      "$value": "rgb(19 36 43 / 0.94)",
      "$description": "Paneles laterales: casi opacos, sin desenfoque.",
      "$extensions": {
        "maquetario": {
          "var": "--material-sidebar"
        }
      }
    },
    "material-bar": {
      "$type": "color",
      "$value": "rgb(23 39 45 / 0.62)",
      "$description": "Barras: vidrio liviano.",
      "$extensions": {
        "maquetario": {
          "var": "--material-bar"
        }
      }
    },
    "material-popover": {
      "$type": "color",
      "$value": "rgb(17 31 37)",
      "$description": "Menús y globos: opacos.",
      "$extensions": {
        "maquetario": {
          "var": "--material-popover"
        }
      }
    },
    "material-sheet": {
      "$type": "color",
      "$value": "#17272d",
      "$description": "Hojas y diálogos: opaco.",
      "$extensions": {
        "maquetario": {
          "var": "--material-sheet"
        }
      }
    },
    "material-scrim": {
      "$type": "color",
      "$value": "rgb(5 12 15 / 0.56)",
      "$description": "Velo detrás de un diálogo.",
      "$extensions": {
        "maquetario": {
          "var": "--material-scrim"
        }
      }
    },
    "material-blur-bar": {
      "$value": "blur(20px) saturate(140%)",
      "$description": "backdrop-filter de las barras, las únicas que dejan ver el material del sistema (texto CSS: DTCG no tiene tipo para filtros).",
      "$extensions": {
        "maquetario": {
          "var": "--material-blur-bar",
          "css": "filter"
        }
      }
    },
    "material-edge": {
      "$value": "inset 0 1px 0 rgb(255 255 255 / 0.07)",
      "$description": "Luz de borde superior del vidrio (box-shadow inset, texto CSS).",
      "$extensions": {
        "maquetario": {
          "var": "--material-edge",
          "css": "shadow"
        }
      }
    }
  },
  "elevation": {
    "$description": "Sombras de elevación como texto CSS (box-shadow).",
    "elevation-1": {
      "$value": "0 1px 2px rgb(0 0 0 / 0.28)",
      "$description": "Controles apoyados.",
      "$extensions": {
        "maquetario": {
          "var": "--elevation-1",
          "css": "shadow"
        }
      }
    },
    "elevation-2": {
      "$value": "0 6px 16px -6px rgb(0 0 0 / 0.42), 0 1px 2px rgb(0 0 0 / 0.22)",
      "$description": "Menús y globos.",
      "$extensions": {
        "maquetario": {
          "var": "--elevation-2",
          "css": "shadow"
        }
      }
    },
    "elevation-3": {
      "$value": "0 22px 56px -16px rgb(0 0 0 / 0.58), 0 2px 8px rgb(0 0 0 / 0.26)",
      "$description": "Diálogos.",
      "$extensions": {
        "maquetario": {
          "var": "--elevation-3",
          "css": "shadow"
        }
      }
    }
  },
  "type": {
    "$type": "dimension",
    "$description": "Roles tipográficos (los de macOS). Tamaño en modo Cómodo; en Maquetario se multiplican por --ui-scale (Grande: 1,15) y viven en body.",
    "type-caption2": {
      "$value": "10px",
      "$description": "Atajos de teclado.",
      "$extensions": {
        "maquetario": {
          "var": "--type-caption2",
          "scope": "body"
        }
      }
    },
    "type-footnote": {
      "$value": "11px",
      "$description": "Ayudas, unidades, texto secundario; mínimo legible.",
      "$extensions": {
        "maquetario": {
          "var": "--type-footnote",
          "scope": "body"
        }
      }
    },
    "type-callout": {
      "$value": "12px",
      "$description": "Etiquetas de campos, filas, controles compactos.",
      "$extensions": {
        "maquetario": {
          "var": "--type-callout",
          "scope": "body"
        }
      }
    },
    "type-body": {
      "$value": "13px",
      "$description": "Texto y controles principales.",
      "$extensions": {
        "maquetario": {
          "var": "--type-body",
          "scope": "body"
        }
      }
    },
    "type-headline": {
      "$value": "13px",
      "$description": "Subtítulos (con peso semibold).",
      "$extensions": {
        "maquetario": {
          "var": "--type-headline",
          "scope": "body"
        }
      }
    },
    "type-title3": {
      "$value": "15px",
      "$description": "Título de confirmación.",
      "$extensions": {
        "maquetario": {
          "var": "--type-title3",
          "scope": "body"
        }
      }
    },
    "type-title2": {
      "$value": "17px",
      "$description": "Títulos de sección y de diálogo.",
      "$extensions": {
        "maquetario": {
          "var": "--type-title2",
          "scope": "body"
        }
      }
    },
    "type-title1": {
      "$value": "22px",
      "$description": "Estados vacíos.",
      "$extensions": {
        "maquetario": {
          "var": "--type-title1",
          "scope": "body"
        }
      }
    },
    "type-large-title": {
      "$value": "26px",
      "$description": "Portadas internas.",
      "$extensions": {
        "maquetario": {
          "var": "--type-large-title",
          "scope": "body"
        }
      }
    }
