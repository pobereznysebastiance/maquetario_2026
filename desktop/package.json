{
  "name": "maquetario",
  "productName": "Maquetario",
  "version": "3.24.0",
  "description": "Maquetario · Maquetación y diseño de libros",
  "author": "Sebastián Poberezny",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron . --dev",
    "start": "electron .",
    "self-test": "node scripts/build.mjs && electron . --self-test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "dist": "node scripts/build.mjs && electron-builder"
  },
  "devDependencies": {
    "@maquetario/license": "*",
    "@types/node": "^26.6.6",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "maquetario": {
    "licenseMode": "off",
    "motiova": {
      "web": "https://motiova.com",
      "api": "https://api.motiova.com/api/v1",
      "dev": {
        "web": "http://localhost:5183",
        "api": "http://localhost:8010/api/v1"
      }
    }
  },
  "build": {
    "appId": "com.motiova.maquetario",
    "productName": "Maquetario",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      {
        "from": "../LibroStudio/v3/app",
        "to": "renderer",
        "filter": [
          "**/*",
          "!**/*-tests.js",
          "!tests/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "../LibroStudio/v3/app/maquetario.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Maquetario"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    },
    "electronLanguages": [
      "es",
      "es-419",
      "en-US",
      "pt-BR"
    ],
    "artifactName": "Maquetario-${version}-${os}-${arch}.${ext}",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
