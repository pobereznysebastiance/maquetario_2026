{
  "name": "maquetario",
  "productName": "Maquetario",
  "version": "0.3.0-beta",
  "description": "Maquetario · Maquetación y diseño de libros",
  "author": "Sebastián Poberezny",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron . --dev",
    "start": "electron .",
    "self-test": "node scripts/build.mjs && electron . --self-test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "dist": "node scripts/build.mjs && electron-builder",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --arm64 --x64",
    "dist:mac-unsigned": "node scripts/build.mjs && electron-builder --mac --arm64 --x64 --config scripts/mac-unsigned.cjs"
  },
  "devDependencies": {
    "@maquetario/license": "*",
    "@types/node": "^26.6.6",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "maquetario": {
    "licenseMode": "off",
    "motiova": {
      "web": "https://motiova.com",
      "api": "https://api.motiova.com/api/v1",
      "dev": {
        "web": "http://localhost:5183",
        "api": "http://localhost:8010/api/v1"
      }
    }
  },
  "build": {
    "appId": "com.motiova.maquetario",
    "productName": "Maquetario",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      {
        "from": "../LibroStudio/v3/app",
        "to": "renderer",
        "filter": [
          "**/*",
          "!**/*-tests.js",
          "!tests/**",
          "!src/**",
          "!build/*.map",
          "!tsconfig.json",
          "!globals.d.ts"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "../LibroStudio/v3/app/maquetario.ico",
      "fileAssociations": [
        {
          "ext": "mqt",
          "name": "Proyecto de Maquetario",
          "description": "Proyecto de Maquetario",
          "icon": "../LibroStudio/v3/app/maquetario.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Maquetario"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "icon": "assets/icon.png",
      "fileAssociations": [
        {
          "ext": "mqt",
          "name": "Proyecto de Maquetario",
          "role": "Editor"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "icon": "assets/icon.png",
      "fileAssociations": [
        {
          "ext": "mqt",
          "name": "Proyecto de Maquetario",
          "description": "Proyecto de Maquetario",
          "mimeType": "application/x-maquetario"
        }
      ]
    },
    "electronLanguages": [
      "es",
      "es-419",
      "en-US",
      "pt-BR"
    ],
    "artifactName": "Maquetario-${version}-${os}-${arch}.${ext}",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
