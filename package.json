{
  "name": "maquetario-monorepo",
  "private": true,
  "description": "Maquetario: editor de maquetación editorial. Programa de escritorio (Electron) y paquetes compartidos.",
  "workspaces": [
    "packages/*",
    "desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace desktop",
    "build": "npm run build --workspace desktop",
    "dist": "npm run dist --workspace desktop",
    "self-test": "npm run self-test --workspace desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run lint:design && npm run format:check",
    "license:dev-keys": "npm run dev-keys --workspace @maquetario/license",
    "license:dev-issue": "npm run dev-issue --workspace @maquetario/license --",
    "lint:design": "node scripts/check-design-tokens.mjs",
    "format": "prettier --write \"LibroStudio/v3/app/**/*.js\" \"desktop/src/**/*.ts\" \"desktop/scripts/**/*.mjs\" \"desktop/test/**/*.ts\" \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"scripts/**/*.{js,mjs,cjs}\"",
    "format:check": "prettier --check \"LibroStudio/v3/app/**/*.js\" \"desktop/src/**/*.ts\" \"desktop/scripts/**/*.mjs\" \"desktop/test/**/*.ts\" \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"scripts/**/*.{js,mjs,cjs}\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
