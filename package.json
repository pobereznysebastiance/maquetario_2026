{
  "name": "maquetario-monorepo",
  "private": true,
  "description": "Maquetario: editor de maquetación editorial. Programa de escritorio (Electron) y paquetes compartidos.",
  "workspaces": [
    "packages/*",
    "desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace desktop",
    "build": "npm run build --workspace desktop",
    "dist": "npm run dist --workspace desktop",
    "dist:mac": "npm run dist:mac --workspace desktop",
    "dist:mac-unsigned": "npm run dist:mac-unsigned --workspace desktop",
    "self-test": "npm run self-test --workspace desktop --",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p LibroStudio/v3/app/src/tsconfig.json && npm run typecheck:app",
    "test": "npm run test --workspaces --if-present && npm run lint:design && npm run format:check",
    "license:dev-keys": "npm run dev-keys --workspace @maquetario/license",
    "license:dev-issue": "npm run dev-issue --workspace @maquetario/license --",
    "lint:design": "node scripts/check-design-tokens.mjs && node packages/tokens/scripts/build.mjs --check",
    "format": "prettier --write \"LibroStudio/v3/app/**/*.js\" \"LibroStudio/v3/app/src/**/*.{ts,tsx}\" \"desktop/src/**/*.{ts,tsx}\" \"desktop/scripts/**/*.mjs\" \"desktop/test/**/*.ts\" \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/test/**/*.ts\" \"scripts/**/*.{js,mjs,cjs}\" \"packages/tokens/**/*.{mjs,json}\"",
    "format:check": "prettier --check \"LibroStudio/v3/app/**/*.js\" \"LibroStudio/v3/app/src/**/*.{ts,tsx}\" \"desktop/src/**/*.{ts,tsx}\" \"desktop/scripts/**/*.mjs\" \"desktop/test/**/*.ts\" \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/test/**/*.ts\" \"scripts/**/*.{js,mjs,cjs}\" \"packages/tokens/**/*.{mjs,json}\"",
    "typecheck:app": "tsc -p LibroStudio/v3/app/tsconfig.json --pretty false"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
