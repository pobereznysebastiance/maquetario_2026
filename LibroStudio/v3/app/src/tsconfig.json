{
  // Fuentes TypeScript de la interfaz: estrictas. Las compila desktop/scripts/build.mjs a ../build/.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    // React (etapa 3): JSX automático; los componentes van en .tsx (src/components/, src/react/).
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx", "../globals.d.ts"]
}
