{
  // Tipos sobre el JavaScript de la interfaz (etapa 2): se chequea sin compilar.
  // Los scripts no son módulos: comparten el ámbito global, como en el navegador.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": ["*.js", "ui/*.js", "globals.d.ts", "src/**/*.ts"],
  "exclude": ["pdf-lib.min.js", "sample-image.js", "tests"]
}
